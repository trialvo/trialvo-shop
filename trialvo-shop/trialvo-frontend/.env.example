NEXT_PUBLIC_API_URL=http://localhost:5010/api
INTERNAL_API_URL=http://localhost:5010/api

# ─── Instant indexing ─────────────────────────────────
# Must match SEO_REVALIDATE_SECRET in the backend. Guards POST /api/indexnow,
# which refreshes the sitemap/feed cache and submits changed URLs.
SEO_REVALIDATE_SECRET=

# Key issued for the IndexNow protocol (Bing, Yandex, Seznam, Naver).
# Any 8-128 char hex string works; it is served at /api/indexnow/<key>.
# Leave empty to skip the search-engine ping and only revalidate caches.
INDEXNOW_KEY=
# Override only if the key file is hosted somewhere other than the default
# <siteUrl>/api/indexnow/<key>.
# INDEXNOW_KEY_LOCATION=
