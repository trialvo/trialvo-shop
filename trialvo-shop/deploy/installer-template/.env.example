# Client-editable trial environment (Option 2). Copy to `.env` and edit.

# Your trial domain (used for lease binding + links).
DOMAIN=your-domain.example.com

# Database (an isolated trial DB; the app connects as root inside the stack).
DB_ROOT_PASSWORD=ChangeMeRoot!
DB_NAME=ecom

# Published host ports.
API_PORT=9000
ADMIN_PORT=5173
SHOP_PORT=5000

# Browser-facing origins. These must be reachable from the end-user's browser.
# For a public deployment behind DNS/proxy use e.g. https://api.your-domain and
# https://shop.your-domain. For a local test use the localhost ports below.
PUBLIC_API_ORIGIN=http://localhost:9000
PUBLIC_SHOP_ORIGIN=http://localhost:5000

# App JWT signing secret (for the application's own auth).
JWTSECRET=ChangeMeJwtSecret

# License mode: 1 = trial (trial packs), 0 = paid (paid packs set this automatically).
TRIAL_MODE=1

# Demo admin for first seed (copy from the Trialvo status email — not stored in agent.env).
TRIAL_ADMIN_EMAIL=
TRIAL_ADMIN_PASSWORD=

# Optional: override image references (defaults pull from registry.trialvo.com).
# Used for local/private-registry testing.
# TRIAL_IMAGE_API=localhost:5055/lifestyle-api:trial
# TRIAL_IMAGE_ADMIN=localhost:5055/lifestyle-admin:trial
# TRIAL_IMAGE_SHOP=localhost:5055/lifestyle-shop:trial
# TRIAL_IMAGE_AGENT=localhost:5055/lifestyle-license-agent:trial
