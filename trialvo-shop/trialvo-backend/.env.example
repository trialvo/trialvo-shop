PORT=5000
NODE_ENV=development

# Database (MySQL 8 — Control Plane)
DB_HOST=localhost
DB_PORT=3430
DB_USER=trialvo
DB_PASSWORD=localdev2026
DB_NAME=trialvo_shop

CORS_ORIGIN=http://localhost:8000
JWT_SECRET=local-dev-jwt-secret-trialvo-2026
JWT_EXPIRES_IN=7d

# ─── Trialvo Pay Integration ──────────────────────────
TRIALVO_PAY_BASE_URL=http://localhost:8080
TRIALVO_PAY_SERVICE_ID=28280023-008f-4307-83de-5e4eabb57562
TRIALVO_PAY_API_KEY=0aedfa5c0374153aa3453d06fa3b5a402eb069165742774aeaf8fec9fedc5a70
TRIALVO_PAY_IPN_SECRET=dee0b047cc6e964335880eef1d98f1f41b4006f4d9faba894c8ebabb14714558

# Frontend URL
FRONTEND_URL=http://localhost:8000

# Public Control Plane API base (installer download links, Opt2 agent)
PUBLIC_API_URL=http://localhost:5000

# ─── Secrets / license (REQUIRED in production) ───────
# Dedicated AES key for agent secrets & backup keys at rest (never reuse JWT_SECRET in prod)
BACKUP_MASTER_KEY=
# RS256 private key PEM for lease signing (or use deploy/keys/license_private.pem)
# LICENSE_PRIVATE_KEY=
# LICENSE_PUBLIC_KEY=

# Agent poll defaults (seconds). Steady-state 600; pending commands use FAST.
AGENT_HEARTBEAT_INTERVAL_SEC=600
AGENT_HEARTBEAT_FAST_SEC=30
AGENT_LEASE_INTERVAL_SEC=1800

# Trial soft-destroy after expiry (days). Paid auto-destroy off by default (0).
TRIAL_DESTROY_AFTER_DAYS=7
PAID_DESTROY_AFTER_DAYS=0

# IPN URL
IPN_URL=http://localhost:5000/api/payments/ipn

# ─── Option 1 local Docker provisioning (Docker Desktop) ───
# Without these, hosted trials fall back to fake demo URLs
# (localhost:5000 / :5173) which are NOT real trial stacks.
DOCKER_PROVISION=1
PROVISION_MODE=local

# ─── Option 1 shared Lifestyle demo (no per-trial Docker) ───
SHARED_DEMO_ENABLED=1
SHARED_DEMO_SHOP_URL=http://localhost:5100
SHARED_DEMO_ADMIN_URL=http://localhost:5174
SHARED_DEMO_API_URL=http://localhost:9100
SHARED_DEMO_DB_HOST=127.0.0.1
SHARED_DEMO_DB_PORT=3430
SHARED_DEMO_DB_USER=root
SHARED_DEMO_DB_PASSWORD=localdev2026
SHARED_DEMO_DB_NAME=lifestyle_demo

# Product/CMS media (defaults to trialvo-shop/uploads at package root)
# UPLOAD_DIR=D:/our product/trialvo-shop/uploads
# STORAGE_DRIVER=local
# STORAGE_URL=http://localhost:5000

