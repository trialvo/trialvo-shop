# ─── PayVault Environment Template ──────────────────────────────────────────
# Copy this file to .env and fill in all values before starting Docker.
# NEVER commit the filled .env file to version control!

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=payvault
POSTGRES_USER=payvault
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_HERE

DATABASE_URL=postgresql://payvault:CHANGE_THIS_STRONG_PASSWORD_HERE@postgres:5432/payvault

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD_HERE
REDIS_URL=redis://:CHANGE_THIS_REDIS_PASSWORD_HERE@redis:6379

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
MASTER_KEY=GENERATE_WITH_openssl_rand_hex_32

# Generate RSA key pair:
# openssl genrsa -out private.pem 2048
# openssl rsa -in private.pem -pubout -out public.pem
# Then base64 encode:
# base64 -w 0 private.pem
# base64 -w 0 public.pem
JWT_PRIVATE_KEY=BASE64_ENCODED_RSA_PRIVATE_KEY
JWT_PUBLIC_KEY=BASE64_ENCODED_RSA_PUBLIC_KEY

# ─── Application ──────────────────────────────────────────────────────────────
# Local cargo run: use http://localhost:8080 and localhost DB/Redis hosts.
# Docker app service: use service hostnames (postgres/redis) and public BASE_URL.
BASE_URL=http://localhost:8080
HOST=0.0.0.0
PORT=8080
RUST_LOG=info

# For local cargo run, DATABASE_URL / REDIS_URL should use localhost:
# DATABASE_URL=postgresql://payvault:CHANGE_THIS_STRONG_PASSWORD_HERE@localhost:5432/payvault
# REDIS_URL=redis://:CHANGE_THIS_REDIS_PASSWORD_HERE@localhost:6379

# ─── NOTE: EPS credentials are stored in the database (system_config table)   
# and encrypted with MASTER_KEY. Configure them via the Admin panel after setup.
# Do NOT put EPS credentials here.
