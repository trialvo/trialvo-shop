<!doctype html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml"
  xmlns:o="urn:schemas-microsoft-com:officeoffice">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta http-equiv="x-ua-compatible" content="ie=edge" />
  <meta name="format-detection" content="telephone=no,address=no,email=no,date=no,url=no" />

  <!-- Allow clients that support it to switch -->
  <meta name="color-scheme" content="light dark" />
  <meta name="supported-color-schemes" content="light dark" />

  <title>{{headline}} | {{BRAND_NAME}}</title>

  <!--[if mso]>
      <xml>
        <o:OfficeDocumentSettings>
          <o:AllowPNG />
          <o:PixelsPerInch>96</o:PixelsPerInch>
        </o:OfficeDocumentSettings>
      </xml>
    <![endif]-->

  <style>
    /* Client resets */
    html,
    body {
      margin: 0 !important;
      padding: 0 !important;
      width: 100% !important;
      height: 100% !important;
    }

    * {
      -ms-text-size-adjust: 100%;
      -webkit-text-size-adjust: 100%;
    }

    table,
    td {
      mso-table-lspace: 0pt !important;
      mso-table-rspace: 0pt !important;
      border-collapse: collapse !important;
    }

    img {
      -ms-interpolation-mode: bicubic;
      border: 0;
      outline: none;
      text-decoration: none;
      display: block;
      height: auto;
      max-width: 100%;
    }

    a {
      text-decoration: none;
    }

    .ExternalClass {
      width: 100%;
    }

    .ExternalClass,
    .ExternalClass * {
      line-height: 100%;
    }

    /* Preheader (hidden) */
    .preheader {
      display: none !important;
      visibility: hidden;
      opacity: 0;
      color: transparent;
      height: 0;
      width: 0;
      max-height: 0;
      max-width: 0;
      overflow: hidden;
      mso-hide: all;
    }

    /* Base */
    .font {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, "Noto Sans",
        "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", sans-serif;
    }

    /* Light defaults */
    .wrapper {
      width: 100%;
      background: #f3f4f6;
    }

    .container {
      width: 100%;
      max-width: 600px;
      margin: 0 auto;
    }

    .card {
      background: #ffffff;
      border: 1px solid #e5e7eb;
      border-radius: 18px;
      overflow: hidden;
    }

    .divider {
      height: 1px;
      background: #e5e7eb;
      line-height: 1px;
      font-size: 1px;
    }

    .h1 {
      font-size: 28px;
      line-height: 34px;
      font-weight: 700;
      color: #111827;
    }

    .h2 {
      font-size: 20px;
      line-height: 26px;
      font-weight: 700;
      color: #111827;
    }

    .p {
      font-size: 16px;
      line-height: 24px;
      color: #6b7280;
    }

    .muted {
      font-size: 14px;
      line-height: 20px;
      color: #6b7280;
    }

    .link {
      color: #2563eb;
      text-decoration: underline;
    }

    .btnWrap {
      border-radius: 12px;
      background: #111827;
    }

    .btnText {
      display: inline-block;
      padding: 12px 18px;
      font-size: 15px;
      line-height: 20px;
      font-weight: 700;
      color: #ffffff;
    }

    .announcement-image {
      border-radius: 12px;
      overflow: hidden;
      margin: 0 auto;
      max-width: 100%;
    }

    .content-body {
      font-size: 16px;
      line-height: 24px;
      color: #6b7280;
    }

    .content-body h1,
    .content-body h2,
    .content-body h3 {
      color: #111827;
      margin-top: 20px;
      margin-bottom: 12px;
    }

    .content-body h1 {
      font-size: 24px;
      font-weight: 700;
    }

    .content-body h2 {
      font-size: 20px;
      font-weight: 600;
    }

    .content-body h3 {
      font-size: 18px;
      font-weight: 600;
    }

    .content-body ul,
    .content-body ol {
      padding-left: 20px;
      margin: 12px 0;
    }

    .content-body li {
      margin-bottom: 6px;
    }

    .content-body p {
      margin: 12px 0;
    }

    .content-body a {
      color: #2563eb;
      text-decoration: underline;
    }

    .content-body strong {
      font-weight: 700;
      color: #111827;
    }

    .content-body em {
      font-style: italic;
    }

    /* Mobile */
    @media screen and (max-width: 600px) {
      .container {
        width: 100% !important;
        max-width: 100% !important;
      }

      .px {
        padding-left: 16px !important;
        padding-right: 16px !important;
      }

      .cardPad {
        padding: 18px !important;
      }

      .h1 {
        font-size: 24px !important;
        line-height: 30px !important;
      }

      .h2 {
        font-size: 18px !important;
        line-height: 24px !important;
      }

      .p {
        font-size: 15px !important;
        line-height: 22px !important;
      }

      .content-body {
        font-size: 15px !important;
        line-height: 22px !important;
      }

      .logoImg {
        width: 150px !important;
      }

      .announcement-image {
        border-radius: 8px !important;
      }
    }

    /* Dark mode (supported clients only)
         IMPORTANT: use !important to override inline display */
    @media (prefers-color-scheme: dark) {
      .wrapper {
        background: #0b1220 !important;
      }

      .card {
        background: #0f172a !important;
        border-color: #1f2937 !important;
      }

      .divider {
        background: #1f2937 !important;
      }

      .h1,
      .h2 {
        color: #f9fafb !important;
      }

      .p,
      .muted {
        color: #cbd5e1 !important;
      }

      .link {
        color: #93c5fd !important;
      }

      .btnWrap {
        background: #2563eb !important;
      }

      .content-body {
        color: #cbd5e1 !important;
      }

      .content-body h1,
      .content-body h2,
      .content-body h3 {
        color: #f9fafb !important;
      }

      .content-body strong {
        color: #f9fafb !important;
      }

      .content-body a {
        color: #93c5fd !important;
      }

      /* Swap logos */
      .logoLight {
        display: none !important;
        mso-hide: all !important;
      }

      .logoDark {
        display: block !important;
      }
    }
  </style>
</head>

<body class="font" style="margin: 0; padding: 0; background: #f3f4f6">
  <div class="preheader">
    {{#if image}}New announcement from {{BRAND_NAME}}: {{headline}}{{else}}{{headline}}{{/if}}
  </div>

  <table role="presentation" class="wrapper" width="100%" cellpadding="0" cellspacing="0" border="0">
    <tr>
      <td align="center" style="padding: 18px 10px">
        <table role="presentation" class="container" width="100%" cellpadding="0" cellspacing="0" border="0">
          <tr>
            <td class="card">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <!-- Header -->
                <tr>
                  <td align="center" class="px" style="padding: 22px 22px 14px">
                    <!-- Light logo (DEFAULT) -->
                    <img class="logoImg logoLight" src="{{SHOP_URL}}/logo-default.svg"
                      width="160" alt="{{BRAND_NAME}}" style="width: 160px; height: auto; display: block;" />

                    <!-- Dark logo (HIDDEN by default via INLINE display:none) -->
                    <img class="logoImg logoDark" src="{{SHOP_URL}}/logo-white.svg"
                      width="160" alt="{{BRAND_NAME}}" style="width: 160px; height: auto; display: none;" />
                  </td>
                </tr>

                <tr>
                  <td class="px" style="padding: 0 22px">
                    <div class="divider"></div>
                  </td>
                </tr>

                <!-- Body -->
                <tr>
                  <td class="cardPad px" style="padding: 24px 22px 6px">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                      <!-- Announcement Header -->
                      <tr>
                        <td align="center" style="padding-bottom: 16px">
                          {{!-- <img src="https://cdn.graduatefashionbd.com/icon/otp_icon_email.png" width="84" alt="Announcement"
                            style="width: 84px; height: auto" /> --}}
                        </td>
                      </tr>

                      <tr>
                        <td align="center" style="padding: 6px 0 4px">
                          <div class="h1">{{headline}}</div>
                        </td>
                      </tr>

                      <tr>
                        <td align="center" style="padding: 0 0 16px">
                          <div class="p" style="margin: 0">
                            Important announcement from {{BRAND_NAME}}
                          </div>
                        </td>
                      </tr>

                      <!-- Announcement Image (Conditional) -->
                      {{#if image}}
                      <tr>
                        <td align="center" style="padding: 0 0 24px">
                          <div class="announcement-image">
                            <img src="{{image}}" alt="{{headline}}" width="560" 
                              style="width: 100%; max-width: 560px; height: auto; border-radius: 12px;" />
                          </div>
                        </td>
                      </tr>
                      {{/if}}

                      <!-- Announcement Content -->
                      <tr>
                        <td style="padding: 0 0 20px">
                          <div class="content-body">
                            {{{body}}}
                          </div>
                        </td>
                      </tr>

                      <!-- Call to Action Button -->
                      <tr>
                        <td align="center" style="padding: 8px 0 24px">
                          <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                              <td align="center" class="btnWrap" style="border-radius: 12px; background: #111827">
                                <a href="{{SHOP_URL}}" target="_blank" class="btnText" style="
                                      display: inline-block;
                                      padding: 12px 18px;
                                      font-size: 15px;
                                      line-height: 20px;
                                      font-weight: 700;
                                      color: #ffffff;
                                    ">
                                  Visit {{BRAND_NAME}}
                                </a>
                              </td>
                            </tr>
                          </table>
                        </td>
                      </tr>

                      <!-- Announcement Details -->
                      <tr>
                        <td style="padding: 0 0 14px">
                          <div class="h2" style="margin-bottom: 12px">Announcement Details</div>
                          <div class="p" style="margin-bottom: 8px">
                            • This is an official announcement from {{BRAND_NAME}}<br>
                            {{#if is_subscribed}}
                            • Sent to all active subscribers and registered users<br>
                            • You're receiving this because you've opted to receive updates
                            {{else}}
                            • Sent to all registered users<br>
                            • You're receiving this as an important service announcement
                            {{/if}}
                          </div>
                        </td>
                      </tr>

                      <!-- Help Section -->
                      <tr>
                        <td style="padding: 0 0 14px">
                          <div class="p" style="margin-bottom: 8px">
                            <strong>Have questions about this announcement?</strong> Feel free to reach out to our support team.
                          </div>
                          <div class="muted">
                            We're here to help you with any queries or concerns you may have.
                          </div>
                        </td>
                      </tr>

                      <!-- Divider -->
                      <tr>
                        <td style="padding: 16px 0">
                          <div class="divider"></div>
                        </td>
                      </tr>

                      <!-- Unsubscribe Notice (Conditional) -->
                      {{#if is_subscribed}}
                      <tr>
                        <td style="padding: 0 0 14px">
                          <div class="muted" style="text-align: center; font-size: 13px;">
                            <strong>Note:</strong> This email was sent to you as an announcement from {{BRAND_NAME}}.<br>
                            If you no longer wish to receive these announcements, you can
                            <a href="{{unsubscribe_url}}" class="link">unsubscribe here</a>.
                          </div>
                          <div style="height: 8px; line-height: 8px; font-size: 8px">&nbsp;</div>
                          <div class="muted" style="text-align: center; font-size: 12px; color: #9ca3af;">
                            Please do not reply to this email. For inquiries, contact our support team.
                          </div>
                        </td>
                      </tr>
                      {{else}}
                      <tr>
                        <td style="padding: 0 0 14px">
                          <div class="muted" style="text-align: center; font-size: 13px;">
                            <strong>Note:</strong> This email was sent to you as an important service announcement from {{BRAND_NAME}}.
                          </div>
                          <div style="height: 8px; line-height: 8px; font-size: 8px">&nbsp;</div>
                          <div class="muted" style="text-align: center; font-size: 12px; color: #9ca3af;">
                            Please do not reply to this email. For inquiries, contact our support team.
                          </div>
                        </td>
                      </tr>
                      {{/if}}
                    </table>
                  </td>
                </tr>

                <!-- Footer divider -->
                <tr>
                  <td class="px" style="padding: 0 22px">
                    <div class="divider"></div>
                  </td>
                </tr>

                <!-- Footer -->
                <tr>
                  <td align="center" class="px" style="padding: 16px 22px 20px">
                    <div class="muted">{{BRAND_NAME}} | {{BRAND_ADDRESS}}</div>

                    <div style="height: 10px; line-height: 10px; font-size: 10px">&nbsp;</div>

                    <div class="muted">
                      <a href="{{SHOP_URL}}/privacy-policy" class="link">Privacy Policy</a>
                      &nbsp;|&nbsp;
                      <a href="{{SHOP_URL}}/terms" class="link">Terms and Conditions</a>
                    </div>

                    <div style="height: 10px; line-height: 10px; font-size: 10px">&nbsp;</div>

                    <div class="muted">
                      If you have any questions please contact us<br />
                      <a href="mailto:support@vellora.demo" class="link">support@vellora.demo</a>
                      &nbsp;|&nbsp;
                      <a href="tel:+8801970680283" class="link">+880 1970-680283</a>
                    </div>

                    <div style="height: 16px; line-height: 16px; font-size: 16px">&nbsp;</div>

                    <div class="muted">
                      <a href="{{SHOP_URL}}" class="link">Website</a>
                      &nbsp;•&nbsp;
                      <a href="#" class="link">Facebook</a>
                      &nbsp;•&nbsp;
                      <a href="#" class="link">LinkedIn</a>
                      &nbsp;•&nbsp;
                      <a href="#" class="link">Instagram</a>
                    </div>

                    <div style="height: 14px; line-height: 14px; font-size: 14px">&nbsp;</div>

                    <div style="font-size: 12px; line-height: 18px; color: #9ca3af">
                      © {{current_year}} {{BRAND_NAME}}. All rights reserved.
                    </div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td style="height: 18px; line-height: 18px; font-size: 18px">&nbsp;</td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>

</html>