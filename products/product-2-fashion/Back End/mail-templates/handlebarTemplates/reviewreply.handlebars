<!doctype html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta http-equiv="x-ua-compatible" content="ie=edge" />
  <meta name="format-detection" content="telephone=no,address=no,email=no,date=no,url=no" />
  <meta name="color-scheme" content="light dark" />
  <meta name="supported-color-schemes" content="light dark" />
  <title>{{BRAND_NAME}} — Response to Your Product Review</title>
  <!--[if mso]>
  <xml>
    <o:OfficeDocumentSettings>
      <o:AllowPNG />
      <o:PixelsPerInch>96</o:PixelsPerInch>
    </o:OfficeDocumentSettings>
  </xml>
  <![endif]-->
  <style>
    /* Client resets */
    html, body {
      margin: 0 !important;
      padding: 0 !important;
      width: 100% !important;
      height: 100% !important;
    }
    * {
      -ms-text-size-adjust: 100%;
      -webkit-text-size-adjust: 100%;
    }
    table, td {
      mso-table-lspace: 0pt !important;
      mso-table-rspace: 0pt !important;
      border-collapse: collapse !important;
    }
    img {
      -ms-interpolation-mode: bicubic;
      border: 0;
      outline: none;
      text-decoration: none;
      display: block;
      height: auto;
    }
    a { text-decoration: none; }
    .ExternalClass { width: 100%; }
    .ExternalClass, .ExternalClass * { line-height: 100%; }
    
    /* Preheader (hidden) */
    .preheader {
      display: none !important;
      visibility: hidden;
      opacity: 0;
      color: transparent;
      height: 0;
      width: 0;
      max-height: 0;
      max-width: 0;
      overflow: hidden;
      mso-hide: all;
    }
    
    /* Base */
    .font {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, "Noto Sans",
        "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", sans-serif;
    }
    
    /* Light defaults */
    .wrapper {
      width: 100%;
      background: #f3f4f6;
    }
    .container {
      width: 100%;
      max-width: 600px;
      margin: 0 auto;
    }
    .card {
      background: #ffffff;
      border: 1px solid #e5e7eb;
      border-radius: 18px;
      overflow: hidden;
    }
    .divider {
      height: 1px;
      background: #e5e7eb;
      line-height: 1px;
      font-size: 1px;
    }
    
    .h1 {
      font-size: 28px;
      line-height: 34px;
      font-weight: 800;
      color: #111827;
    }
    .p {
      font-size: 16px;
      line-height: 24px;
      color: #6b7280;
    }
    .muted {
      font-size: 14px;
      line-height: 20px;
      color: #6b7280;
    }
    .link {
      color: #2563eb;
      text-decoration: underline;
    }
    .name {
      font-weight: 700;
      color: #111827;
    }
    
    /* Button */
    .btnWrap {
      border-radius: 12px;
      background: #111827;
    }
    .btnText {
      display: inline-block;
      padding: 12px 18px;
      font-size: 15px;
      line-height: 20px;
      font-weight: 800;
      color: #ffffff;
    }
    
    /* Star rating */
    .starRating {
      font-size: 22px;
      letter-spacing: 2px;
      color: #f59e0b;
    }
    
    /* Message boxes */
    .messageBox {
      width: 100%;
      max-width: 520px;
      background: #f9fafb;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      overflow: hidden;
      margin-bottom: 16px;
    }
    .messageHeader {
      padding: 12px 16px;
      background: #f3f4f6;
      border-bottom: 1px solid #e5e7eb;
    }
    .messageBody {
      padding: 16px;
    }
    .customerMessage {
      background: #f0f9ff;
      border-color: #bae6fd;
    }
    .customerHeader {
      background: #e0f2fe;
      border-bottom-color: #bae6fd;
    }
    .supportMessage {
      background: #f0fdf4;
      border-color: #bbf7d0;
    }
    .supportHeader {
      background: #dcfce7;
      border-bottom-color: #bbf7d0;
    }
    
    /* Meta cards */
    .metaBox {
      width: 100%;
      max-width: 520px;
      background: #f9fafb;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
    }
    .metaKey {
      font-size: 12px;
      line-height: 18px;
      color: #6b7280;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.6px;
    }
    .metaVal {
      font-size: 14px;
      line-height: 20px;
      color: #111827;
      font-weight: 700;
    }
    
    /* Logos */
    .logoLight { display: block; }
    .logoDark { display: none; }
    
    /* Mobile */
    @media screen and (max-width: 600px) {
      .container {
        width: 100% !important;
        max-width: 100% !important;
      }
      .px {
        padding-left: 16px !important;
        padding-right: 16px !important;
      }
      .cardPad {
        padding: 18px !important;
      }
      .h1 {
        font-size: 24px !important;
        line-height: 30px !important;
      }
      .p {
        font-size: 15px !important;
        line-height: 22px !important;
      }
      .logoImg { width: 150px !important; }
      .messageBox { max-width: 100% !important; }
    }
    
    /* Dark mode */
    @media (prefers-color-scheme: dark) {
      .wrapper { background: #0b1220 !important; }
      .card {
        background: #0f172a !important;
        border-color: #1f2937 !important;
      }
      .divider { background: #1f2937 !important; }
      .h1 { color: #f9fafb !important; }
      .p, .muted { color: #cbd5e1 !important; }
      .name { color: #f9fafb !important; }
      .link { color: #93c5fd !important; }
      .btnWrap { background: #2563eb !important; }
      
      .messageBox {
        background: #111827 !important;
        border-color: #1f2937 !important;
      }
      .messageHeader {
        background: #1f2937 !important;
        border-bottom-color: #374151 !important;
      }
      .customerMessage {
        background: #0c4a6e !important;
        border-color: #0369a1 !important;
      }
      .customerHeader {
        background: #075985 !important;
        border-bottom-color: #0369a1 !important;
      }
      .supportMessage {
        background: #064e3b !important;
        border-color: #059669 !important;
      }
      .supportHeader {
        background: #065f46 !important;
        border-bottom-color: #059669 !important;
      }
      
      .metaBox {
        background: #111827 !important;
        border-color: #1f2937 !important;
      }
      .metaKey { color: #cbd5e1 !important; }
      .metaVal { color: #f9fafb !important; }
      
      .logoLight {
        display: none !important;
        mso-hide: all !important;
      }
      .logoDark { display: block !important; }
    }
  </style>
</head>

<body class="font" style="margin: 0; padding: 0; background: #f3f4f6">
  <div class="preheader">
    Hi {{name}}, we've responded to your review of "{{product_name}}". Check it out below.
  </div>

  <table role="presentation" class="wrapper" width="100%" cellpadding="0" cellspacing="0" border="0">
    <tr>
      <td align="center" style="padding: 18px 10px">
        <table role="presentation" class="container" width="100%" cellpadding="0" cellspacing="0" border="0">
          <tr>
            <td class="card">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <!-- Header -->
                <tr>
                  <td align="center" class="px" style="padding: 22px 22px 14px">
                    <img class="logoImg logoLight" src="{{SHOP_URL}}/logo-default.svg" width="160" alt="{{BRAND_NAME}}" style="width: 160px; height: auto; display: block" />
                    <img class="logoImg logoDark" src="{{SHOP_URL}}/logo-white.svg" width="160" alt="{{BRAND_NAME}}" style="width: 160px; height: auto; display: none" />
                  </td>
                </tr>

                <tr>
                  <td class="px" style="padding: 0 22px">
                    <div class="divider"></div>
                  </td>
                </tr>

                <!-- Body -->
                <tr>
                  <td class="cardPad px" style="padding: 24px 22px 6px">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                      <!-- Title -->
                      <tr>
                        <td align="center" style="padding: 6px 0 4px">
                          <div class="h1">
                            Response to Your Review
                          </div>
                        </td>
                      </tr>

                      <!-- Greeting -->
                      <tr>
                        <td align="center" style="padding: 0 0 10px">
                          <div class="p" style="margin: 0">
                            Hi <span class="name">{{name}}</span>,
                          </div>
                        </td>
                      </tr>

                      <!-- Intro -->
                      <tr>
                        <td align="center" style="padding: 0 0 16px">
                          <div class="p">
                            Thank you for reviewing <strong>{{product_name}}</strong>. Our team has read your feedback and responded below.
                          </div>
                        </td>
                      </tr>

                      <!-- Review Info -->
                      <tr>
                        <td align="center" style="padding: 0 0 14px">
                          <table role="presentation" class="metaBox" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                              <td style="padding: 14px 14px">
                                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                  <tr>
                                    <td style="padding: 6px 0">
                                      <div class="metaKey">Product</div>
                                      <div class="metaVal">{{product_name}}</div>
                                    </td>
                                    <td style="padding: 6px 0" class="right">
                                      <div class="metaKey">Reviewed On</div>
                                      <div class="metaVal">{{review_date}}</div>
                                    </td>
                                  </tr>
                                  <tr>
                                    <td colspan="2" style="padding: 6px 0">
                                      <div class="metaKey">Your Rating</div>
                                      <div class="starRating">{{star_display}}</div>
                                    </td>
                                  </tr>
                                </table>
                              </td>
                            </tr>
                          </table>
                        </td>
                      </tr>

                      <!-- Customer's Review -->
                      <tr>
                        <td align="center" style="padding: 0 0 12px">
                          <table role="presentation" class="messageBox customerMessage" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                              <td class="messageHeader customerHeader">
                                <div class="metaKey">YOUR REVIEW</div>
                              </td>
                            </tr>
                            <tr>
                              <td class="messageBody">
                                <div class="p" style="margin: 0; white-space: pre-line;">{{review_text}}</div>
                              </td>
                            </tr>
                          </table>
                        </td>
                      </tr>

                      <!-- Admin Response -->
                      <tr>
                        <td align="center" style="padding: 0 0 20px">
                          <table role="presentation" class="messageBox supportMessage" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                              <td class="messageHeader supportHeader">
                                <div class="metaKey">OUR RESPONSE</div>
                              </td>
                            </tr>
                            <tr>
                              <td class="messageBody">
                                <div class="p" style="margin: 0; white-space: pre-line;">{{reply_text}}</div>
                              </td>
                            </tr>
                          </table>
                        </td>
                      </tr>

                      <!-- CTA -->
                      <tr>
                        <td align="center" style="padding: 8px 0 10px">
                          <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                              <td align="center" class="btnWrap" style="border-radius: 12px; background: #111827">
                                <a href="{{PRODUCT_PAGE}}" target="_blank" class="btnText" style="display: inline-block; padding: 12px 18px; font-size: 15px; line-height: 20px; font-weight: 800; color: #ffffff;">
                                  View Product
                                </a>
                              </td>
                            </tr>
                          </table>
                        </td>
                      </tr>

                      <!-- Additional Info -->
                      <tr>
                        <td align="center" style="padding: 0 0 14px">
                          <div class="muted">
                            <strong>We value your feedback!</strong><br>
                            Your review helps other customers make informed decisions.
                          </div>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>

                <!-- Footer divider -->
                <tr>
                  <td class="px" style="padding: 0 22px">
                    <div class="divider"></div>
                  </td>
                </tr>

                <!-- Footer -->
                <tr>
                  <td align="center" class="px" style="padding: 16px 22px 20px">
                    <div class="muted">{{BRAND_NAME}} | {{BRAND_ADDRESS}}</div>
                    <div style="height: 10px; line-height: 10px; font-size: 10px">&nbsp;</div>
                    <div class="muted">
                      <a href="{{SHOP_URL}}/privacy-policy" class="link">Privacy Policy</a>
                      &nbsp;|&nbsp;
                      <a href="{{SHOP_URL}}/terms" class="link">Terms and Conditions</a>
                    </div>
                    <div style="height: 10px; line-height: 10px; font-size: 10px">&nbsp;</div>
                    <div class="muted">
                      If you have any questions please contact us<br />
                      <a href="mailto:support@vellora.demo" class="link">support@vellora.demo</a>
                      &nbsp;|&nbsp;
                      <a href="tel:+8801970680283" class="link">+880 1970-680283</a>
                    </div>
                    <div style="height: 16px; line-height: 16px; font-size: 16px">&nbsp;</div>
                    <div class="muted">
                      <a href="{{SHOP_URL}}" class="link">Website</a>
                      &nbsp;•&nbsp;
                      <a href="#" class="link">Facebook</a>
                      &nbsp;•&nbsp;
                      <a href="#" class="link">LinkedIn</a>
                      &nbsp;•&nbsp;
                      <a href="#" class="link">Instagram</a>
                    </div>
                    <div style="height: 14px; line-height: 14px; font-size: 14px">&nbsp;</div>
                    <div style="font-size: 12px; line-height: 18px; color: #9ca3af">
                      © {{year}} {{BRAND_NAME}}. All rights reserved.
                    </div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td style="height: 18px; line-height: 18px; font-size: 18px">&nbsp;</td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
