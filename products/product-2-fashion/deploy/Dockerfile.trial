# Trial/prod image: uses obfuscated bundle from dist-obf (TS-5.5)
# Run from "product 1 life style" after: node deploy/obfuscate-backend.js
FROM node:18-slim

WORKDIR /usr/src/app

COPY ["Back End/package.json", "./"]
COPY ["Back End/package-lock.json*", "./"]
RUN npm ci --omit=dev || npm install --omit=dev

COPY ["Back End/dist-obf/", "./"]

RUN groupadd -g 1001 nodejs && useradd -m -u 1001 -g nodejs nodejs \
  && chown -R nodejs:nodejs /usr/src/app
USER nodejs

EXPOSE 8080
ENV NODE_ENV=production
ENV TRIAL_MODE=1

CMD ["node", "index.js"]
